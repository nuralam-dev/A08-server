# Local development. Merge missing values into .env; preserve existing secrets.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/A08
MONGODB_DB_NAME=A08
CLIENT_URL=http://localhost:3000
AUTH_BASE_URL=http://localhost:3000
API_AUTH_MODE=jwt
# These defaults match the frontend JWT plugin when enabled without overrides.
JWT_ISSUER=http://localhost:3000
JWT_JWKS_URL=http://localhost:3000/api/auth/jwks
JWT_AUDIENCE=http://localhost:4000
# MongoDB must be a replica set or Atlas cluster for booking transactions.
# Production: replace all localhost origins with the actual HTTPS origins.
# JWT_AUDIENCE must exactly match the frontend (e.g. the identifier studiospace-api).
# JWT_ISSUER/JWT_JWKS_URL may be omitted to derive from AUTH_BASE_URL.
# Remove obsolete CLIENT_ORIGIN; conflicting CLIENT_URL/CLIENT_ORIGIN fails startup.
# No BetterAuth secret or private signing key belongs on this API server.
