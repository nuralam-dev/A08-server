# Local development: copy values into .env without overwriting existing secrets.
PORT=4000
CLIENT_URL=http://localhost:3000
# BetterAuth is hosted in Next.js, not Express. Defaults to CLIENT_URL.
AUTH_BASE_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/A08
# Must match the frontend configuration.
API_AUTH_MODE=jwt
JWT_AUDIENCE=studiospace-api
# CLIENT_ORIGIN is supported as a legacy fallback when CLIENT_URL is absent.
